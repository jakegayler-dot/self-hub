# Railway provides DATABASE_URL automatically once you add a Postgres plugin
# to this service — you do not set it yourself.
DATABASE_URL=postgres://user:password@localhost:5432/self_hub

# Set these in Railway's environment variables (Settings → Variables).
# Your browser will prompt for these credentials the first time you open the app.
SELF_HUB_USER=jake
SELF_HUB_PASS=change-me-to-something-real

# Optional — a separate credential pair for the future Sentinel service, so
# it never needs your personal login and either one can be rotated or
# revoked independently. Leave unset until Sentinel exists; the app runs
# fine without these.
SENTINEL_USER=sentinel
SENTINEL_PASS=change-me-to-something-real-too

# Optional — push the Fitness tile summary (strength score, training week,
# needs-input) to Sentinel. Leave either unset and the push is disabled (the
# app logs that once at boot). SENTINEL_URL is Sentinel's base URL, no path.
SENTINEL_URL=
SENTINEL_API_KEY=

# Do NOT set PORT manually on Railway — it injects this itself and a manual
# value can conflict with Railway's routing (this bit Jake on the House Hub deploy).
